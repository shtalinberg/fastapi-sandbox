
PROJECT_NAME="FastAPI Sandbox"
DEBUG=False

# Database settings
DATABASE_URL=postgresql://fasandbox_user:fasandbox_pass@localhost:5432/fasandbox_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=fasandbox_user
DB_PASSWORD=fasandbox_pass
DB_NAME=fasandbox_db

# Redis settings
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT settings
SECRET_KEY=your-secret-key-for-change
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API settings
API_V1_STR=/api/v1

# External API settings
EXTERNAL_API_URL=https://jsonplaceholder.typicode.com
SYNC_INTERVAL_MINUTES=60
